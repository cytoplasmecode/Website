<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.PlantWatering" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorBackground">@color/bg_base</item>

        <!-- Accent -->
        <item name="colorPrimary">@color/green_500</item>
        <item name="colorPrimaryVariant">@color/green_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/green_400</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Status / nav bar -->
        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:navigationBarColor">@color/bg_base</item>

        <!-- Shape overrides — round everything -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeSmall</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeMedium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeLarge</item>

        <!-- Toolbar -->
        <item name="toolbarStyle">@style/PlantToolbar</item>
    </style>

    <style name="Theme.PlantWatering" parent="Base.Theme.PlantWatering" />

    <!-- Rounded shape scales -->
    <style name="ShapeSmall" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeMedium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeLarge" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Toolbar style -->
    <style name="PlantToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/bg_base</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="titleTextAppearance">@style/ToolbarTitle</item>
    </style>
    <style name="ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Rounded square FAB -->
    <style name="FabShape" parent="ShapeAppearance.MaterialComponents">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
</resources>
